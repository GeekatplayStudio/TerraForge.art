               "sp2_scale": 0.6, "scale": 1.0, "variation": 0.4, "footprint_m": 8, "clump_amount": 0.5, "clump_size_m": 160,
               "use_slope": true, "slope": [0, 28], "slope_fuzz": 6, "slope_influence": 0.6 } },
  { "op": "connect", "from": "soil", "from_port": "texture", "to": "trees", "to_port": "below albedo" },
