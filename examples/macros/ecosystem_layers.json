  { "op": "set_scatter", "object": "Bush",  "node": "trees", "species": 2, "size": 1.0, "jitter": 0.0 },
  { "op": "add_primitive", "kind": "cone",   "name": "Tuft",  "position": [0.5, 0.0, 0.5], "scale": 0.0004, "color": [0.35, 0.55, 0.18] },
