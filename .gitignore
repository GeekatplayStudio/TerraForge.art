# build output
/build/
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.pdb
*.ilk

# third-party sources fetched by scripts/get_deps.ps1 / scripts/get_deps.sh
/external/

# packaging output: the installers, the portable archive, the app bundle and
# the debug symbols kept beside them. Built by packaging/*, published as
# release assets, never committed.
/dist/
/build/package/

# private development notes, research and roadmaps (not published)
/docs_private/
# Reference imagery kept beside the project - 72 MB of it, and growing. Git
# keeps every blob it has ever seen, so this would sit in the history for
# good; it is working material, not source.
/referance/

# reference material / scratch clones
/_temp_hesiod/

# machine-specific tooling output
compile_commands.json
.vscode/
.clangd
*.wal
*.log

# runtime logs and crash reports (studio/crash_log.cpp) - local only
/logs/

# app state written at runtime
geekatplay_studio_layout.ini
geekatplay_graph_view*.json
terraforge_prefs.json
imgui.ini
*.gpxt
# ...except the golden corpus, which is the regression lock's evidence
!tests/projects/*.gpxt
!examples/*.gpxt
terraforge_render*.png
# the render op's default output, written wherever the app was started
/render.png

# python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# os
Thumbs.db
desktop.ini
.DS_Store

# scratch files from experiments, never part of the build
/fp.cpp
/*.tmp.cpp
